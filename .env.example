# ============================================================
# B 站评论爬虫 & 数据看板 配置模板
# 使用方法：复制本文件为 .env，然后按需修改
#    cp .env.example .env        (Linux / macOS)
#    copy .env.example .env      (Windows)
# ============================================================

# ---------- MongoDB ----------
# MongoDB 连接串
MONGO_URI=mongodb://localhost:27017
# 数据库名
DB_NAME=bilibili
# 评论集合名
COLLECTION_NAME=comments
# 连接超时（毫秒）
MONGO_TIMEOUT_MS=3000

# ---------- B 站接口 ----------
# 请求 User-Agent
BILI_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
# 登录 Cookie（敏感信息！）。
# 获取方式：浏览器登录 bilibili.com 后，按 F12 -> 网络 -> 复制请求头中的完整 Cookie 串。
# 留空则匿名访问（部分接口可能返回空数据或触发风控）。
BILI_COOKIE=

# ---------- Web 服务 ----------
HOST=0.0.0.0
PORT=5000
# 1 = 开启调试模式；生产环境请设为 0
DEBUG=0
